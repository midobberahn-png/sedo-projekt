# Optionales Beispiel für den lokalen Einzelplatzbetrieb.
# Als .env nur lokal speichern. Diese Datei enthält KEINE echten Zugangsdaten.
DJANGO_DEBUG=0
SEDO_LOCAL_ONLY=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Leerer Schlüssel: SEDO erzeugt und speichert einen eigenen Zufallsschlüssel.
# Keinen Beispieltext als DJANGO_SECRET_KEY übernehmen.
DJANGO_SECRET_KEY=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
SEDO_TRUSTED_PROXIES=

# Netzwerkbetrieb niemals durch bloßes Ändern des Listeners freischalten.
# Eigene HTTPS-/Proxy-Konfiguration und separate Abnahme sind erforderlich.
# Siehe DEPLOYMENT_SECURITY_NOTES.md.

# Optional: lokaler Bonsai-Server, kein Cloud-Fallback.
# SEDO_AI_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# SEDO_AI_LOCAL_MODEL=

# Optional: Zugangsdaten ausschließlich lokal setzen; niemals veröffentlichen.
# SEDO_SMTP_PASSWORD=
# SEDO_FINTS_PIN=
# SEDO_WEATHER_API_KEY=
