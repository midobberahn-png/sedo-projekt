# Seit v3.22 ist DEBUG auch OHNE .env standardmäßig aus (sicherer Default).
# Nur für Entwicklung auf 1 setzen.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY="CHANGE-ME-GENERATE-A-STRONG-SECRET-KEY"
DJANGO_ALLOWED_HOSTS=rechnung.sedo-magdeburg.de,178.105.130.97,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://rechnung.sedo-magdeburg.de
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
# Optional: Secrets per Umgebung statt in der Datenbank (Env hat Vorrang).
# Lokaler Bonsai-Server: nur Loopback-Adressen, kein Cloud-Fallback.
# SEDO_AI_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# SEDO_AI_LOCAL_MODEL=
# SEDO_SMTP_PASSWORD=...
# Optional: Wetter.com / METEONOMIQS PWA Forecast API v4.0 (Nowcast).
# Alternativ unter Einstellungen → Wetter.com hinterlegen.
# SEDO_WEATHER_API_KEY=...
