# Bytegleicher Checkout für Quell-/Lockhashes auf Windows und macOS.
# Keine rückwirkende Zeilenenden-Normalisierung bestehender CRLF-Starter.
# Textdiffs bleiben aktiv; lediglich die automatische EOL-Konvertierung entfällt.
* -text
*.icns binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.sqlite3 binary
*.zip binary
*.pdf binary

# Never export operational state with source archives (existing Git history is unchanged).
data export-ignore
media export-ignore
backups export-ignore
logs export-ignore
mail-cache export-ignore
security-state export-ignore
.env export-ignore
